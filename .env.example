# CloneStore — Environment Variables Example
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Next.js / App ──────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ───────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Stripe ─────────────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# GO-LIVE 02: Pierre recurring price — 449 EUR/mois. Set after creating live price in Stripe Dashboard.
# STRIPE_PRICE_PIERRE=price_...            # (legacy EUR alias — still accepted as the EUR price)
#
# P10 — Country pricing (launch: FR/BE/LU = 449 EUR ; CH = 499 CHF). Server-authoritative.
# Country-aware checkout is OPT-IN and OFF by default (existing single-price flow untouched).
# When enabled, BOTH price IDs must be set — there is NO cross-currency fallback (CH never uses EUR,
# FR/BE/LU never use CHF). Missing CHF/EUR price fails closed.
# STRIPE_PRICE_PIERRE_EUR_MONTHLY=price_...   # FR/BE/LU — 449 EUR/mois (or reuse STRIPE_PRICE_PIERRE)
# STRIPE_PRICE_PIERRE_CHF_MONTHLY=price_...   # CH — 499 CHF/mois (no alias; required for CH checkout)
# STRIPE_COUNTRY_PRICING_ENABLED=false        # true = activate country-aware public pricing + checkout guard

# ── B32: AI Runtime ────────────────────────────────────────────────────────────
# Controls whether AI providers are called.
# mock (default) = no real API calls, safe for dev/test without keys
# disabled = all AI requests blocked
# production = real API calls via configured providers

AI_RUNTIME_MODE=mock

# ── B32: Anthropic (Claude) ────────────────────────────────────────────────────
# Claude Opus 4.7 = livrables premium client (documents, PDF, contrats, rapports)
# Claude Sonnet 4.6 = raisonnement structuré
# Claude Haiku 4.5 = micro-tâches rapides

ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides (defaults used if not set):
AI_ANTHROPIC_OPUS_MODEL=claude-opus-4-7
AI_ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
AI_ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# ── B32: OpenAI ────────────────────────────────────────────────────────────────
# GPT-4.1 = mission planning, orchestration, risque standard
# GPT-4.1-mini = micro-tâches, classification, extraction, statuts

OPENAI_API_KEY=sk-...

# Optional model overrides (defaults used if not set):
AI_OPENAI_STRONG_MODEL=gpt-4.1
AI_OPENAI_FAST_MODEL=gpt-4.1-mini

# Optional embeddings model overrides:
AI_EMBEDDINGS_QUALITY_MODEL=text-embedding-3-large
AI_EMBEDDINGS_COST_MODEL=text-embedding-3-small

# ── B32: Budget enforcement ────────────────────────────────────────────────────
# Costs in USD cents. Defaults: $5/day, $100/month, $1/single call.

AI_DEFAULT_DAILY_BUDGET_CENTS=500
AI_DEFAULT_MONTHLY_BUDGET_CENTS=10000
AI_SINGLE_CALL_MAX_CENTS=100

# ── B32: Logging ───────────────────────────────────────────────────────────────
# Set to "true" to include prompt content in usage trace logs (disabled by default for privacy).

AI_LOG_PROMPTS=false

# ── B32: Timeouts / limits (optional, defaults apply if not set) ──────────────

# AI_PROVIDER_TIMEOUT_MS=20000
# AI_MAX_OUTPUT_TOKENS_DEFAULT=2048

# ── B33: Channel Identity Layer ────────────────────────────────────────────────
# "mock" = no real sends (default, safe for dev/test)
# "disabled" = all sends blocked (stricter lockdown)
# "production" = real sends via configured provider

CHANNEL_RUNTIME_MODE=mock

# Set to "true" ONLY for production when provider is verified
# CHANNEL_ALLOW_UNVERIFIED_SEND=false

# Set to "true" to store message body in envelopes/events (disabled by default for privacy)
# CHANNEL_LOG_BODY=false

# Default rate limits (overridable per channel identity in DB)
# CHANNEL_MAX_HOURLY_SENDS_DEFAULT=50
# CHANNEL_MAX_DAILY_SENDS_DEFAULT=500

# Default provider (mock is always used unless a real provider is configured)
# CHANNEL_DEFAULT_PROVIDER=mock

# ── B37: Resend email provider ─────────────────────────────────────────────────
# Set EMAIL_PROVIDER=resend and CHANNEL_DEFAULT_PROVIDER=resend to enable.
# CHANNEL_RUNTIME_MODE must also be set to "production" for real sends.
# EMAIL_SEND_LIVE and EMAIL_DRY_RUN are independent safety switches.

# EMAIL_PROVIDER=resend                     # Set to "resend" to activate Resend
# RESEND_API_KEY=re_...                     # Your Resend API key (never commit)
# RESEND_DEFAULT_FROM=Pierre <noreply@example.com>
# RESEND_ALLOWED_FROM_DOMAINS=example.com  # Comma-separated allowed from-domains
# RESEND_SANDBOX_TO=sandbox@yourteam.com   # Redirect ALL sends here in dev/staging

# EMAIL_SEND_LIVE=false    # Must be explicitly "true" to allow real delivery
# EMAIL_DRY_RUN=true       # Set to "false" ONLY when live send is fully validated

# ── B34: Files & Document Intake Layer ────────────────────────────────────────
# "mock"  = no real storage, pipeline runs fully in-memory (default, safe for dev/test)
# "local" = local filesystem storage (dev only)
# "disabled" = all file intake blocked
# "production" = real cloud storage (Supabase Storage or S3)

FILE_RUNTIME_MODE=mock

# Max file upload size in MB (default: 25 MB)
FILE_MAX_UPLOAD_MB=25

# Max extracted text preview in characters (default: 4000)
FILE_TEXT_PREVIEW_CHARS=4000

# Set to "true" to store full extracted text in DB (disabled by default for privacy/RGPD)
# FILE_LOG_EXTRACTED_TEXT=false

# Allowed file types (all true by default in mock mode)
FILE_ALLOW_IMAGES=true
FILE_ALLOW_OFFICE_DOCS=true
FILE_ALLOW_PDF=true

# Archives (zip, rar, tar) — disabled by default for security
# FILE_ALLOW_ARCHIVES=false

# Supabase Storage or S3 bucket name for file storage
FILE_STORAGE_BUCKET=pierre-documents

# ── B38A: AI Cost Shield ───────────────────────────────────────────────────────
# Protects against uncontrolled AI consumption from non-paying users.
# Gael's budget: ~9.74€ OpenAI. Every cent counts.
# Default: enforce mode — non-paying users get 0€ AI.
# NEVER set public_demo or unpaid to "true" without explicit budget planning.

AI_COST_SHIELD_MODE=enforce
# disabled | observe | enforce
# enforce = block non-paying users (default, safe)
# observe = log warnings but don't block (for debugging)
# disabled = no enforcement (dev only, NEVER in production)

AI_EMERGENCY_SHUTDOWN=false
# Set to "true" to immediately block ALL AI calls globally (kill switch)

# ── Public/demo safety (default: all false = 0€ for non-paying) ───────────────
AI_PUBLIC_DEMO_ALLOW_REAL_CALLS=false
AI_UNPAID_ALLOW_REAL_CALLS=false
AI_TRIAL_ALLOW_REAL_CALLS=false
# No 7-day open-bar trial. Demo is static. Non-paying = mock only.

# ── Provider policy ────────────────────────────────────────────────────────────
AI_OPENAI_ENABLED=true
AI_ANTHROPIC_ENABLED=false
# Anthropic/Claude is DISABLED until B38B+ and explicit budget allocation.
AI_ALLOWED_PROVIDERS=openai,mock
AI_DEFAULT_PROVIDER=openai
AI_OPENAI_ONLY=true
AI_ANTHROPIC_FALLBACK_ENABLED=false

# ── Hard caps in cents (100 cents = 1€) ────────────────────────────────────────
# With 9.74€ budget, start conservative. Increase only after B38B validation.
AI_GLOBAL_DAILY_CAP_CENTS=300
# 3€/day global (all companies combined)
AI_GLOBAL_MONTHLY_CAP_CENTS=1000
# 10€/month global cap
AI_COMPANY_DAILY_CAP_CENTS=100
# 1€/day per company
AI_COMPANY_MONTHLY_CAP_CENTS=500
# 5€/month per company
AI_USER_DAILY_CAP_CENTS=50
# 0.50€/day per user
AI_USER_MONTHLY_CAP_CENTS=200
# 2€/month per user
AI_MISSION_CAP_CENTS=30
# 0.30€ per mission max

# ── Premium model protection ───────────────────────────────────────────────────
AI_PREMIUM_MODEL_DAILY_CAP_CENTS=0
# Premium models (Opus etc.) disabled globally for now
AI_FREE_PREMIUM_MODEL_CAP_CENTS=0
# Non-paying users: 0€ premium model budget
AI_PAID_PREMIUM_MODEL_CAP_CENTS=100
# Paying customers: up to 1€ premium model budget (only if Anthropic re-enabled)

# ── Demo configuration ─────────────────────────────────────────────────────────
DEMO_RUNTIME_MODE=static
# static = no AI calls, serve pre-written demo content (default)
# mock = use mock provider (0€ but needs mock setup)
# real = real AI (NEVER for public demo without explicit approval)
DEMO_AI_COST_CENTS=0
# Public demo AI cost must always be 0

# ── Cost logging (no PII by default) ──────────────────────────────────────────
AI_COST_LOG_PROMPTS=false
AI_COST_LOG_COMPLETIONS=false
# Never log prompts or completions — contains sensitive HR data

# ── B38B: OpenAI Live Validation ───────────────────────────────────────────────
# B38B = internal validation layer. NOT public. NOT triggered in normal CI.
# ALL flags default to safe values. Live mode requires explicit opt-in.
#
# NEVER set B38B_LIVE_OPENAI_ENABLED=true in CI or shared environments.
# NEVER run b38b:live-openai without confirming budget and key availability.
# Gaël's budget: ~9.74€. Keep B38B_MAX_TOTAL_COST_CENTS <= 75 for initial runs.

# Master switch — must be explicitly "true" to allow any live API call
B38B_LIVE_OPENAI_ENABLED=false

# Hard cost cap in cents (100 cents = 1€). Absolute max: 150. Start with 75.
B38B_MAX_TOTAL_COST_CENTS=75

# Max scenarios per run (1-10). 5 is a safe starting point.
B38B_MAX_SCENARIOS=5

# Access level required for B38B runs (do not change — internal_admin only)
B38B_ALLOWED_ACCESS_LEVEL=internal_admin

# Allow strong model calls (gpt-4.1 vs gpt-4.1-mini). Costs more. Keep false unless needed.
B38B_ALLOW_STRONG_MODEL_CALLS=false
B38B_STRONG_MODEL_MAX_CALLS=2

# Where to save validation reports (git-ignored, local only)
B38B_OUTPUT_REPORT_DIR=.local-reports/b38b

# Store full AI outputs in report? (false = excerpt only — safer)
B38B_STORE_FULL_OUTPUTS=false

# Redact API key patterns from outputs (always true in production)
B38B_REDACT_OUTPUTS=true

# When running live: these MUST also be set (usually already set above)
# AI_RUNTIME_MODE=production
# AI_COST_SHIELD_MODE=enforce
# OPENAI_API_KEY=sk-...  (already set in B32 section above)

# ── B38C: AI Cost Ledger ───────────────────────────────────────────────────────
# Persistent, auditable per-event cost tracking.
# Default: memory provider (no Supabase needed for npm test / npm run build).
# Supabase opt-in: set provider=supabase + service role key above.

AI_COST_LEDGER_PROVIDER=memory
# memory    = in-process array, resets on restart (dev/test default)
# supabase  = persist to cloneos_ai_cost_events (requires SUPABASE_SERVICE_ROLE_KEY)
# disabled  = no ledger, all writes silently dropped

AI_COST_LEDGER_WRITE_MODE=memory
# memory     = write to in-memory array only
# supabase   = write to Supabase only
# dual_write = write to both (dev validation)
# disabled   = drop all writes

AI_COST_LEDGER_FAIL_CLOSED=false
# false = DB write failures warn + continue (never breaks AI calls)
# true  = DB write failures throw AiCostLedgerWriteError (strict enforcement)

AI_COST_LEDGER_REDACT_METADATA=true
# true = strip prompt/content/completion/output from event metadata (always recommended)
# false = store metadata as-is (only for internal debugging)

# AI_COST_LEDGER_LOG_METADATA=false
# AI_COST_LEDGER_DAILY_CAP_CENTS=300    # Default: inherits AI_GLOBAL_DAILY_CAP_CENTS
# AI_COST_LEDGER_MONTHLY_CAP_CENTS=1000 # Default: inherits AI_GLOBAL_MONTHLY_CAP_CENTS

# ── B39: Live Email Production ─────────────────────────────────────────────────
# Ultra-secure email layer. Default: mock — no provider calls, no real sends.
# Non-paying users are ALWAYS blocked (anonymous, logged_unpaid, trial).
# NEVER set EMAIL_SEND_LIVE=true without confirming production is ready.
# NEVER log RESEND_API_KEY. NEVER store email body in audit events.
# For tests: always use mock mode. Never inject RESEND_API_KEY in CI.

# Email runtime mode — mock is the official default
# mock     = no provider call, fake result (default — safe for all tests)
# dry_run  = no provider call by default, policy validated only (EMAIL_DRY_RUN_PROVIDER_CALLS=true to opt in)
# sandbox  = no provider call by default, recipients → EMAIL_SANDBOX_TO (EMAIL_SANDBOX_SEND_LIVE=true to opt in)
# live     = real delivery (requires EMAIL_SEND_LIVE=true + RESEND_API_KEY + paid_customer)
EMAIL_RUNTIME_MODE=mock

# Safety gates — ALL must be true for live delivery
EMAIL_SEND_LIVE=false
EMAIL_DRY_RUN=true

# B39.1 — Dry run provider opt-in (false by default — dry_run never calls provider)
EMAIL_DRY_RUN_PROVIDER_CALLS=false

# B39.1 — Sandbox live opt-in (false by default — sandbox never calls provider)
# Requires EMAIL_SEND_LIVE=true AND RESEND_API_KEY to have any effect
EMAIL_SANDBOX_SEND_LIVE=false

# Sandbox redirect — ALL emails go here in sandbox mode (when provider called)
# EMAIL_SANDBOX_TO=sandbox@yourteam.com

# ── Recipient policy ───────────────────────────────────────────────────────────
# Glob patterns, comma-separated. Empty = allow all.
# EMAIL_RECIPIENT_ALLOWLIST=*@verified-client.com,admin@*
# EMAIL_RECIPIENT_BLOCKLIST=*@competitor.com,spam@*
# EMAIL_MAX_RECIPIENTS_PER_SEND=10

# ── Rate limits ────────────────────────────────────────────────────────────────
# In-memory only — resets on process restart. No Supabase required.
# EMAIL_RATE_HOURLY_PER_COMPANY=50
# EMAIL_RATE_DAILY_PER_COMPANY=200
# EMAIL_RATE_HOURLY_PER_USER=10
# EMAIL_RATE_DAILY_PER_USER=50

# ── Audit ──────────────────────────────────────────────────────────────────────
# Email audit events are in-memory by default (resets on restart).
# Supabase opt-in: run docs/sql/B39_EMAIL_AUDIT.sql and set provider below.
# EMAIL_AUDIT_PROVIDER=memory   # memory | supabase
# EMAIL_LOG_BODY=false           # NEVER true in production — contains HR data

# ── B43: Observability / Error Handling Production ─────────────────────────────
# Secret for internal diagnostics and events routes.
# REQUIRED to access /api/pierre/observability/diagnostics and /events.
# Never expose in client-side code. Rotate regularly.

PIERRE_INTERNAL_DIAGNOSTICS_SECRET=your-internal-secret-here

# Feature flags (all default to safe values)
PIERRE_OBSERVABILITY_ENABLED=true
# true  = observability active (default)
# false = disabled (no events recorded)

PIERRE_DEAD_LETTER_ENABLED=false
# false = dead letters tracked in-memory only (default)
# true  = dead letter persistence enabled

PIERRE_CLONE_GUARD_ENABLED=true
# true  = CloneGuard security checks active (default — never disable in prod)
# false = disabled (dev only, marks system as degraded)

PIERRE_MAX_AI_BUDGET_EUR=
# Maximum AI spend in euros before budget guard activates.
# Leave empty to disable budget guard (NOT recommended for production).
# Example: 10.00 = 10€ max

# Pierre agent identity (default: pierre)
# PIERRE_AGENT_SLUG=pierre

# ── B46: CloneStore Technologies Configuration ─────────────────────────────────
# Controls technology runtime modes and features for all 6 visible CloneStore techs.
# Default: all techs in safe/mock modes. Never disable CloneGuard or CloneTrace.

# Configuration provider: memory (default, no DB) or supabase (persists to DB)
CLONESTORE_TECHNOLOGIES_CONFIG_PROVIDER=memory
# memory   = in-process, resets on restart (default — safe for dev/test)
# supabase = persists overrides to Supabase (requires SUPABASE_SERVICE_ROLE_KEY)

# Individual technology opt-in (all default to enabled=true)
# CLONEOS_ENABLED=true         # CloneOS — NEVER disable in production
# CLONEADN_ENABLED=true        # CloneADN — degraded mode ok
# CLONEGUARD_ENABLED=true      # CloneGuard — LOCKED, cannot be set to false
# CLONETRACE_ENABLED=true      # CloneTrace — LOCKED, cannot be set to false
# CLONEVOICE_ENABLED=false     # CloneVoice — disabled by default (B47+)
# CLONECHAT_ENABLED — C1.2: CloneChat is REVEALED and ACTIVE BY DEFAULT (unset/empty = active).
#   No env value is required to run the authenticated CloneChat surface.
#   Emergency kill switch ONLY: set CLONECHAT_ENABLED=false (or 0/off/disabled/no) to
#   fail-close the page AND /api/assistant/chat and show an honest "temporarily
#   unavailable" state (never the old "arrive bientôt"). "Active" ≠ public anonymous
#   access: the API always requires Supabase auth + a server-resolved company.
# CLONECHAT_ENABLED=false      # (emergency shutdown only — leave unset for normal active use)

# Voice / Chat runtime modes (independent from AI_RUNTIME_MODE)
# CLONEVOICE_RUNTIME_MODE=disabled    # disabled | mock | sandbox | production
# CLONECHAT_RUNTIME_MODE=dry_run      # dry_run | mock | sandbox | production

# Internal admin override — forces all locked techs to production mode
# CLONESTORE_FORCE_PRODUCTION=false   # NEVER set to true in dev/test

# ── B47: Legal & Commercial Guardrails ─────────────────────────────────────────
# Controls legal/commercial safety for Pierre and CloneStore outputs.
# Required in production to enforce legal limits and protect commercial promises.

# Enable legal guardrails in all API routes (required in production)
PIERRE_LEGAL_GUARDRAILS_ENABLED=true

# Monthly price (must match Stripe price_id and CGV)
PIERRE_MONTHLY_PRICE_EUR=449

# Founder pricing (lock-in price for early subscribers)
PIERRE_FOUNDER_PRICING_ENABLED=true

# Demo mode: no real AI, no email.send, no official doc export
# Set to false in production (paid customers only)
PIERRE_DEMO_MODE=false

# Enable output validation on all Pierre document/email routes
PIERRE_OUTPUT_VALIDATION_ENABLED=true

# Legal review status (informational only — does not block code)
# PIERRE_LEGAL_REVIEW_DONE=false   # Set to true after legal review of CGU/CGV/Privacy

# ── B48: Final Launch Readiness ─────────────────────────────────────────────────
# Controls and tracks the final pre-launch readiness state of CloneStore/Pierre.
# Verdict: technical_ready_public_blocked until all manual blockers resolved.

# Enable the B48 launch readiness dashboard and API endpoints
CLONESTORE_LAUNCH_READINESS_ENABLED=true

# CRITICAL: Set to true ONLY after ALL manual blockers are resolved:
#   - CGU/CGV published + legally validated
#   - Privacy policy complete and RGPD-compliant
#   - Legal review of B47 guardrails done by a lawyer
#   - RLS verified in production
#   - Stripe live keys configured and tested
# NEVER set to true before all above are done.
CLONESTORE_PUBLIC_LAUNCH_APPROVED=false

# Stripe price ID for 449€/month subscription (must match PIERRE_MONTHLY_PRICE_EUR)
# NEXT_PUBLIC_STRIPE_PRICE_ID=price_...   # Set after creating live price in Stripe

# ── P-FINAL 01: Public Launch Closure ─────────────────────────────────────────
# Manual flags and proof ids required before public launch.
# CRITICAL: Never set to true without real evidence.
# See docs/PFINAL01_GO_LIVE_CHECKLIST.md for full instructions.

# Stripe live price ID (Pierre Annual — 449€)
# STRIPE_PIERRE_ANNUAL_PRICE_ID=price_...  # Set after creating live annual price in Stripe

# P-FINAL 01 manual verification flags (all default to false — never change without proof)
# B48_LEGAL_REVIEW_COMPLETED=false          # Set true only after lawyer validates DPA
# B48_CGU_CGV_PRIVACY_VERIFIED=false        # Set true only after lawyer validates CGU/CGV/Privacy
# B48_SUPABASE_RLS_VERIFIED=false           # Set true only after RLS applied + cross-company test passed
# B48_STRIPE_PRODUCTION_VERIFIED=false      # Set true only after Stripe live flow tested end-to-end
# B48_PUBLIC_LAUNCH_ENABLED=false           # Set true LAST — only when ALL blockers are cleared

# P-FINAL 01 demo configuration (always static — never real AI in public demo)
# PFINAL01_DEMO_MODE=static                 # static | mock — never "real"
# PFINAL01_DEMO_AI_COST_CENTS=0             # Must always be 0

# RLS deployment flag (informational — actual RLS is in Supabase, not here)
# PFINAL01_RLS_APPLIED_PRODUCTION=false     # Set true after PFINAL01_RLS_PRODUCTION_PACK.sql applied

# Copy scanner mode (run at build time to detect forbidden copy in public pages)
# PFINAL01_COPY_SCAN_ENABLED=true           # true = scan runs at build/deploy (recommended)
# PFINAL01_COPY_SCAN_FAIL_ON_BLOCKING=true  # true = build fails if blocking violations found

# ── P-FINAL 02 — Go-Live Manual Proofs & Production Activation Gate ───────────
# Human-verified proof system. All flags default to safe values.
# CRITICAL: Never set these based on assumption — only after real evidence is recorded
#           in go-live-proofs.local.json (git-ignored, local only).
# See docs/PFINAL02_GO_LIVE_MANUAL_PROOFS.md for the full proof list and instructions.

# Path to the local proof file (git-ignored — never committed)
GO_LIVE_PROOFS_FILE=go-live-proofs.local.json

# Require all public launch proofs before enabling public launch
GO_LIVE_REQUIRE_ALL_PUBLIC_PROOFS=true

# Allow private pilot mode (subset of proofs verified)
# Set to true only after PFINAL02_PRIVATE_PILOT_PROTOCOL.md conditions are met
GO_LIVE_ALLOW_PRIVATE_PILOT=false

# Manual proof mode: all verdict computation is based on local proof file only
GO_LIVE_MANUAL_PROOF_MODE=true

# Lock: prevents B48_PUBLIC_LAUNCH_ENABLED from being set without proof verdict = go
# NEVER set to false — this is a safety gate
GO_LIVE_PUBLIC_LAUNCH_FLAG_LOCKED=true

# ── GO-LIVE 01E: RLS Runtime Verification Test Users ──────────────────────────
# Optional: used by scripts/rls-runtime-verify.mjs for cross-user isolation test.
# Create two separate Supabase test accounts (never use real client data).
# If not set, the script runs anon-only tests and skips cross-user isolation.

# RLS_TEST_USER_A_EMAIL=test-user-a@example.com
# RLS_TEST_USER_A_PASSWORD=
# RLS_TEST_USER_B_EMAIL=test-user-b@example.com
# RLS_TEST_USER_B_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# PROGRAMME « CABINETS FONDATEURS » (partner-program) — commissions 20 % via Connect
# ─────────────────────────────────────────────────────────────────────────────
# PARTNER_PROGRAM_ENABLED=false      # true = ouvre candidature + espace + attribution + commissions (OFF par défaut)
# PARTNER_PAYOUTS_ENABLED=false      # true = active le job mensuel de versement (OFF par défaut, indépendant)
# PARTNER_PAYOUT_DRY_RUN=true        # true (défaut) = calcule les lots sans transfert Stripe ; "false" requis pour Test Mode réel
# CLONESTORE_PP_COOKIE_SECRET=       # secret HMAC du cookie d'attribution (repli sur le secret de réservation fondateur)
# PARTNER_PAYOUT_CRON_SECRET=        # secret du cron de versement (repli sur CRON_SECRET)
# PARTNER_EMAIL_CRON_SECRET=         # secret du cron d'emails partenaires (repli sur CRON_SECRET)
# Réutilise aussi : STRIPE_SECRET_KEY (Connect Test Mode), RESEND_API_KEY + CLONESTORE_FOUNDER_EMAIL_FROM (emails),
# NEXT_PUBLIC_SITE_URL (liens). Le job de versement REFUSE tout transfert live tant que la production
# n'est pas autorisée (plancher P10) — aucune activation Live possible par le code seul.

# ─────────────────────────────────────────────────────────────────────────────
# COCKPIT D'ADMINISTRATION — « porte propriétaire » (Founder Command Center)
# ─────────────────────────────────────────────────────────────────────────────
# Entrées : /founder (officielle) et /internal/<slug>/command-center (historique).
# Chaîne d'accès fail-closed : porte (ces variables) → session Supabase → allowlist email.
#
# ⚠ LES TROIS PREMIÈRES SONT REQUISES EN PRODUCTION. Si une seule manque,
# isOwnerGateConfigured() = false → porte « misconfigured » → 404 sur LES DEUX entrées :
# le cockpit d'administration devient totalement inaccessible. C'est exactement la panne
# qui s'est produite (variables présentes en local, jamais poussées sur Vercel).
#
# CLONESTORE_OWNER_COCKPIT_SLUG=            # segment d'URL secret ; requis AUSSI par /founder
# CLONESTORE_OWNER_COCKPIT_COOKIE_SECRET=   # secret de signature du cookie de porte (32 octets hex)
# CLONESTORE_OWNER_COCKPIT_PASSWORD_HASH_B64=  # base64 du hash scrypt — FORME RECOMMANDÉE (voir ci-dessous)
# CLONESTORE_OWNER_COCKPIT_PASSWORD_HASH=   # forme brute `scrypt$N$r$p$sel$hash` — acceptée, mais fragile
# CLONESTORE_OWNER_ADMIN_EMAILS=            # allowlist d'emails admin (virgule/espace) — sinon 404 après connexion
# CLONESTORE_OWNER_GATE_DIAG=1              # diagnostic serveur opt-in (journalise la raison exacte du refus)
#
# Pourquoi la forme base64 : le hash scrypt contient des « $ » que les chargeurs d'env
# interprètent comme des variables et CORROMPENT (178 → ~10 caractères) ⇒ mot de passe jamais
# reconnu (401 à l'infini). Le base64 traverse intact. Générer le hash :
#   node scripts/owner-hash-util.mjs            (produit les deux formes)
#   node scripts/diagnose-owner-gate.mjs        (diagnostique une porte qui refuse)

# ─────────────────────────────────────────────────────────────────────────────
# ANALYTICS — jeton QA Production (classification `test` authentifiée serveur)
# ─────────────────────────────────────────────────────────────────────────────
# En Production, l'en-tête public `x-clonestore-test` est IGNORÉ : un en-tête non authentifié ne
# doit jamais permettre à un visiteur de masquer son trafic réel. La seule façon d'obtenir une
# classification `traffic_class=test` en Production est de présenter ce secret serveur via l'en-tête
# privé `x-clonestore-qa-token` (comparaison temps constant, voir src/lib/analytics/qa-auth.ts).
#
# Fail-closed : absent, vide ou < 32 caractères ⇒ classification `test` impossible (reste external).
# NE JAMAIS préfixer NEXT_PUBLIC_ (n'entrerait jamais dans le bundle navigateur — ce module importe
# node:crypto et reste serveur). Configurer UNIQUEMENT côté Vercel Production. Générer un secret fort :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CLONESTORE_ANALYTICS_QA_TOKEN=            # secret serveur ≥ 32 caractères ; jamais exposé côté client
