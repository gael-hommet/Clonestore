# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# isolated production-build distDirs used for per-block verification
# (NEXT_DIST_DIR=.next-<block-name>) — reconstructible via `next build`, never
# meant to be committed. Added 2026-07-24 (Validated Worktree Preservation and
# Commit Closure) after finding .next-p10/.next-p11/.next-p12/.next-p13/.next-p96
# already committed by mistake in older history — not removed retroactively
# (out of scope for this block), but no further one should ever be added again.
.next-*/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

